      ]
    },
    {
      "id": "feeling-sick-038",
      "speaker": "parent",
      "level": 3,
      "en": "On a scale of one to ten, how bad does it hurt?",
      "vi": "Nếu chấm từ một tới mười thì con đau cỡ nào?",
      "ages": [
        "7-9"
