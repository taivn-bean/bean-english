  "dialogues": [
    {
      "id": "tidy-up-d01",
      "titleEn": "Clean-up time",
      "titleVi": "Giờ dọn dẹp",
      "lines": [
        {
          "speaker": "mom",
          "en": "Clean-up time!",
          "vi": "Tới giờ dọn dẹp rồi!"
        },
        {
          "speaker": "child",
          "en": "Too many toys!",
          "vi": "Nhiều đồ chơi quá!"
        },
        {
          "speaker": "mom",
          "en": "Let's tidy up together. Can you help me?",
          "vi": "Mình cùng dọn nha. Con phụ mẹ được không?"
        },
        {
          "speaker": "child",
          "en": "I can help!",
          "vi": "Con phụ được!"
        },
        {
          "speaker": "mom",
          "en": "The blocks go in the box.",
          "vi": "Bỏ khối xếp hình vô hộp nha."
        },
        {
          "speaker": "child",
          "en": "In the box!",
          "vi": "Bỏ vô hộp!"
        },
        {
          "speaker": "mom",
          "en": "Wow, so clean! Thank you for helping!",
          "vi": "Oa, sạch quá trời! Cảm ơn con đã phụ nha!"
        }
      ]
    },
    {
      "id": "tidy-up-d02",
      "titleEn": "Where does it go?",
      "titleVi": "Cái này để đâu?",
      "lines": [
        {
          "speaker": "child",
          "en": "Where does it go?",
          "vi": "Cái này để đâu ba?"
        },
        {
          "speaker": "dad",
          "en": "Books go on the shelf.",
          "vi": "Sách thì để lên kệ nha."
        },
        {
          "speaker": "child",
          "en": "On the shelf!",
          "vi": "Lên kệ!"
        },
        {
          "speaker": "dad",
          "en": "Pick up the red blocks.",
          "vi": "Nhặt mấy khối màu đỏ nào."
        },
        {
          "speaker": "child",
          "en": "Red blocks!",
          "vi": "Khối đỏ nè!"
        },
        {
          "speaker": "dad",
          "en": "One, two, three, in!",
          "vi": "Một, hai, ba, vô!"
        },
        {
          "speaker": "child",
          "en": "All tidy!",
          "vi": "Gọn gàng rồi!"
        }
      ]
    },
    {
      "id": "tidy-up-d03",
      "titleEn": "Clean up, then read",
      "titleVi": "Dọn xong rồi đọc sách",
      "lines": [
        {
          "speaker": "mom",
          "en": "First we clean up, then we read a book.",
          "vi": "Mình dọn xong rồi mới đọc sách nha."
        },
        {
          "speaker": "child",
          "en": "Book first!",
          "vi": "Đọc sách trước!"
        },
        {
          "speaker": "mom",
          "en": "Clean up first. Then the book!",
          "vi": "Dọn trước nha con. Rồi mới đọc sách!"
        },
        {
          "speaker": "child",
          "en": "Cars away!",
          "vi": "Cất xe!"
        },
        {
          "speaker": "mom",
          "en": "Wow, so clean! Now let's read!",
          "vi": "Oa, sạch quá trời! Giờ mình đọc sách nào!"
        },
        {
          "speaker": "child",
          "en": "Yay, book!",
          "vi": "Hoan hô, đọc sách!"
