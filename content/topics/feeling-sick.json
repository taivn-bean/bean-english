      "slots": [
        {
          "en": "tissue",
          "vi": "khăn giấy"
        },
        {
          "en": "blanket",
          "vi": "mền"
        },
        {
          "en": "pillow",
          "vi": "cái gối"
        },
        {
          "en": "drink of water",
          "vi": "uống nước"
        }
      ]
    },
    {
