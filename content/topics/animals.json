          "vi": "Con voi to quá!"
        },
        {
          "speaker": "mom",
          "en": "Look, the monkey is eating a banana. Yum, yum!",
          "vi": "Nhìn kìa, con khỉ đang ăn chuối. Măm măm!"
        },
        {
          "speaker": "child",
          "en": "Funny monkey!",
          "vi": "Khỉ ngộ quá!"
        },
        {
          "speaker": "mom",
          "en": "Roar like a lion!",
          "vi": "Gầm như sư tử nào!"
        },
        {
          "speaker": "child",
          "en": "Roar!",
          "vi": "Gừm!"
        }
      ]
    },
    {
      "id": "animals-d03",
      "titleEn": "The sleepy kitty",
