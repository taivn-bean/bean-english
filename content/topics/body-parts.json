  "dialogues": [
    {
      "id": "body-parts-d01",
      "titleEn": "Touch your nose",
      "titleVi": "Chạm vào mũi",
      "lines": [
        {
          "speaker": "dad",
          "en": "Touch your nose!",
          "vi": "Con chạm vào mũi nào!"
        },
        {
          "speaker": "child",
          "en": "Here's my nose!",
          "vi": "Mũi của con nè!"
        },
        {
          "speaker": "dad",
          "en": "Can you point to your eyes?",
          "vi": "Con chỉ vào mắt được không?"
        },
        {
          "speaker": "child",
          "en": "Here! Two eyes!",
          "vi": "Đây nè! Hai con mắt!"
        },
        {
          "speaker": "dad",
          "en": "Great job! Clap your hands!",
          "vi": "Giỏi quá! Vỗ tay nào!"
        },
        {
          "speaker": "child",
          "en": "Clap, clap, clap!",
          "vi": "Vỗ tay, vỗ tay!"
        }
      ]
    },
