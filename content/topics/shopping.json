  "dialogues": [
    {
      "id": "shopping-d01",
      "titleEn": "Pushing the cart",
      "titleVi": "Đẩy xe",
      "lines": [
        {
          "speaker": "mom",
          "en": "Let's get a cart.",
          "vi": "Mình lấy xe đẩy nha."
        },
        {
          "speaker": "child",
          "en": "I want to push!",
          "vi": "Con muốn đẩy!"
        },
        {
          "speaker": "mom",
          "en": "Okay! Push slowly, please.",
          "vi": "Ừ! Đẩy từ từ nha con."
        },
        {
          "speaker": "child",
          "en": "Push, push!",
          "vi": "Đẩy, đẩy!"
        },
        {
          "speaker": "mom",
          "en": "What a big helper!",
          "vi": "Con phụ giỏi quá!"
        }
      ],
      "ages": [
        "3-5"
      ]
    },
    {
      "id": "shopping-d02",
      "titleEn": "Finding fruit",
      "titleVi": "Tìm trái cây",
      "lines": [
        {
          "speaker": "dad",
          "en": "We need some bananas. Can you find them?",
          "vi": "Mình cần mua chuối. Con tìm được không?"
        },
        {
          "speaker": "child",
          "en": "I found it!",
          "vi": "Con tìm thấy rồi!"
        },
        {
          "speaker": "dad",
          "en": "Put the bananas in the cart.",
          "vi": "Bỏ chuối vô xe đẩy nha."
        },
        {
          "speaker": "child",
          "en": "In the cart!",
          "vi": "Bỏ vô xe!"
        },
        {
          "speaker": "dad",
          "en": "How many apples do we need?",
          "vi": "Mình cần mấy trái táo?"
        },
        {
          "speaker": "child",
          "en": "Two apples!",
          "vi": "Hai trái!"
        },
        {
          "speaker": "dad",
          "en": "Good counting!",
          "vi": "Con đếm giỏi quá!"
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "shopping-d03",
      "titleEn": "Not today",
      "titleVi": "Hôm nay chưa mua",
      "lines": [
        {
          "speaker": "child",
          "en": "I want that!",
          "vi": "Con muốn cái đó!"
        },
        {
          "speaker": "mom",
          "en": "Not today. Maybe next time.",
          "vi": "Hôm nay chưa mua nha. Để lần sau."
        },
        {
          "speaker": "child",
          "en": "Please, Mommy?",
          "vi": "Đi mà mẹ?"
        },
        {
          "speaker": "mom",
          "en": "Not today. Let's pay now.",
          "vi": "Hôm nay không mua nha. Mình đi tính tiền nào."
        },
        {
          "speaker": "child",
          "en": "Okay.",
          "vi": "Dạ."
        },
        {
          "speaker": "mom",
          "en": "Can you help me carry the bag?",
          "vi": "Con phụ mẹ xách túi được không?"
        },
        {
          "speaker": "child",
          "en": "I'm strong!",
          "vi": "Con khỏe lắm!"
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "shopping-d04",
      "titleEn": "Checking the list",
      "titleVi": "Coi danh sách",
      "lines": [
        {
          "speaker": "mom",
          "en": "Okay, what's next on the list?",
          "vi": "Rồi, trong danh sách còn món gì nữa con?"
