        {
          "speaker": "dad",
          "en": "It's just thunder.",
          "vi": "Chỉ là tiếng sấm thôi con."
        },
        {
          "speaker": "child",
          "en": "Hug, Daddy!",
          "vi": "Ôm con đi ba!"
        },
        {
          "speaker": "dad",
          "en": "Big hug! You're safe inside with me.",
          "vi": "Ba ôm con nè! Con ở trong nhà với ba, an toàn mà."
        },
        {
          "speaker": "child",
          "en": "I'm okay.",
          "vi": "Con không sao."
        }
      ]
    },
