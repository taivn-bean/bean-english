        { "en": "the park", "vi": "công viên" },
        { "en": "the playground", "vi": "sân chơi" }
      ]
    },
    { "id": "safety-028", "speaker": "child", "level": 1, "en": "Wait for me!", "vi": "Đợi con với!" },
    { "id": "safety-029", "speaker": "child", "level": 1, "en": "Green light!", "vi": "Đèn xanh rồi!" },
    { "id": "safety-030", "speaker": "child", "level": 1, "en": "Too high!", "vi": "Cao quá!" }
