      "speaker": "child",
      "level": 1,
      "en": "My ___ hurts.",
      "vi": "Con đau ___.",
      "slots": [
        {
          "en": "tummy",
          "vi": "bụng"
        },
        {
          "en": "head",
          "vi": "đầu"
        },
        {
          "en": "throat",
          "vi": "họng"
        },
        {
          "en": "ear",
          "vi": "tai"
        }
      ]
    },
    {
      "id": "feeling-sick-016",
      "speaker": "child",
      "level": 2,
      "en": "I don't feel good.",
      "vi": "Con thấy không khỏe."
    },
    {
      "id": "feeling-sick-017",
      "speaker": "child",
      "level": 1,
      "en": "Hold me, please.",
      "vi": "Ôm con đi."
    },
    {
      "id": "feeling-sick-018",
      "speaker": "child",
      "level": 1,
      "en": "Tissue, please.",
      "vi": "Cho con khăn giấy."
    },
    {
      "id": "feeling-sick-019",
      "speaker": "child",
      "level": 1,
      "en": "I'm feeling better!",
      "vi": "Con đỡ rồi!"
    },
    {
      "id": "feeling-sick-020",
      "speaker": "child",
      "level": 1,
      "en": "Achoo!",
      "vi": "Hắt xì!"
    },
    {
      "id": "feeling-sick-021",
      "speaker": "parent",
      "level": 2,
      "en": "Let's take your temperature.",
      "vi": "Mình cặp nhiệt độ nha con."
    },
    {
      "id": "feeling-sick-022",
      "speaker": "parent",
      "level": 2,
      "en": "Open wide. Say ahh.",
      "vi": "Há miệng ra. Nói aaa nào."
    },
    {
      "id": "feeling-sick-023",
      "speaker": "parent",
      "level": 2,
      "en": "Let me feel your ___.",
      "vi": "Để sờ ___ con coi nào.",
      "slots": [
        {
          "en": "forehead",
          "vi": "trán"
        },
        {
          "en": "tummy",
          "vi": "bụng"
        },
        {
          "en": "cheeks",
          "vi": "má"
        }
      ]
    },
    {
      "id": "feeling-sick-024",
      "speaker": "parent",
      "level": 2,
      "en": "Blow your nose. Good job!",
      "vi": "Con hỉ mũi nè. Giỏi lắm!"
    },
    {
      "id": "feeling-sick-025",
      "speaker": "parent",
      "level": 2,
      "en": "This medicine tastes like ___.",
      "vi": "Thuốc này có vị ___ nè.",
