{
  "topicId": "feeling-sick",
  "phrases": [
    {
      "id": "feeling-sick-001",
      "speaker": "parent",
      "level": 1,
      "en": "Are you okay?",
      "vi": "Con có sao không?"
    },
    {
      "id": "feeling-sick-002",
      "speaker": "parent",
      "level": 2,
      "en": "Does your ___ hurt?",
      "vi": "Con đau ___ hả?",
      "slots": [
        {
          "en": "tummy",
          "vi": "bụng"
        },
        {
          "en": "head",
          "vi": "đầu"
        },
        {
          "en": "throat",
          "vi": "họng"
        },
        {
          "en": "ear",
          "vi": "tai"
        }
      ]
    },
    {
      "id": "feeling-sick-003",
      "speaker": "parent",
      "level": 2,
      "en": "Show me where it hurts.",
      "vi": "Con chỉ coi đau chỗ nào nè."
    },
    {
      "id": "feeling-sick-004",
      "speaker": "parent",
      "level": 2,
      "en": "You feel a little warm.",
      "vi": "Người con hơi ấm ấm nè."
    },
    {
