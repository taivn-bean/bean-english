        { "en": "gate", "vi": "cổng" }
      ]
    },
    { "id": "going-out-034", "speaker": "parent", "level": 2, "en": "Let's walk on the sidewalk.", "vi": "Mình đi trên vỉa hè nha." },
    {
      "id": "going-out-035", "speaker": "parent", "level": 2,
      "en": "Look at the big ___!", "vi": "Con nhìn ___ to quá kìa!",
