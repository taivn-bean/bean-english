        { "en": "park", "vi": "công viên" },
        { "en": "store", "vi": "siêu thị" },
        { "en": "library", "vi": "thư viện" }
      ]
    },
    { "id": "going-out-038", "speaker": "child", "level": 2, "en": "Can I walk by myself?", "vi": "Con tự đi được không?" },
    { "id": "going-out-039", "speaker": "child", "level": 2, "en": "I want to go home.", "vi": "Con muốn về nhà." },
    { "id": "going-out-040", "speaker": "child", "level": 1, "en": "Stroller, please!", "vi": "Cho con ngồi xe đẩy!" }
