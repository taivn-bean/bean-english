  "dialogues": [
    {
      "id": "daily-talk-d01",
      "titleEn": "Look at me!",
      "titleVi": "Nhìn con nè!",
      "lines": [
        {
          "speaker": "child",
          "en": "Look, Daddy!",
          "vi": "Ba ơi, nhìn nè!"
        },
        {
          "speaker": "dad",
          "en": "Just a minute. Almost done!",
          "vi": "Chờ xíu nha con. Ba sắp xong rồi!"
        },
        {
          "speaker": "child",
          "en": "Come and see!",
          "vi": "Lại đây xem nè!"
        },
        {
          "speaker": "dad",
          "en": "I'm coming! Wow, that's funny!",
          "vi": "Ba tới liền đây! Oa, buồn cười quá ha!"
        },
        {
          "speaker": "child",
          "en": "Again, again!",
          "vi": "Nữa đi, nữa đi!"
        }
      ]
    },
    {
      "id": "daily-talk-d02",
      "titleEn": "Help, please",
      "titleVi": "Giúp con với",
      "lines": [
        {
          "speaker": "child",
          "en": "Mommy, help!",
          "vi": "Mẹ ơi, giúp con!"
        },
        {
          "speaker": "mom",
          "en": "What's wrong, sweetie? Are you all right?",
          "vi": "Sao vậy con? Con có sao không?"
        },
        {
          "speaker": "child",
          "en": "I need water.",
          "vi": "Con cần nước."
        },
        {
          "speaker": "mom",
          "en": "Wait a moment, please. I'm coming!",
          "vi": "Con đợi một chút nha. Mẹ tới liền đây!"
        },
        {
          "speaker": "child",
          "en": "Okay!",
          "vi": "Dạ!"
        },
        {
          "speaker": "mom",
          "en": "Here you go. Thank you for waiting.",
          "vi": "Nước nè con. Cảm ơn con đã chờ nha."
        }
      ]
    },
    {
      "id": "daily-talk-d03",
      "titleEn": "Your turn!",
      "titleVi": "Tới lượt con!",
      "lines": [
        {
          "speaker": "dad",
          "en": "Do you want to play with me?",
          "vi": "Con muốn chơi chung với ba không?"
        },
        {
          "speaker": "child",
          "en": "Yes!",
          "vi": "Dạ có!"
        },
        {
          "speaker": "dad",
          "en": "Okay! Now it's your turn.",
          "vi": "Được nè! Giờ tới lượt con nha."
        },
        {
          "speaker": "child",
          "en": "Look, Daddy!",
          "vi": "Ba ơi, nhìn nè!"
        },
        {
          "speaker": "dad",
          "en": "Good try! Try again.",
          "vi": "Con cố gắng giỏi lắm! Thử lại nha."
        },
        {
          "speaker": "child",
          "en": "Again, again!",
          "vi": "Nữa đi, nữa đi!"
        },
        {
          "speaker": "dad",
          "en": "You can do it!",
          "vi": "Con làm được mà!"
        }
      ]
    }
  ]
