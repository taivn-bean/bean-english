  "dialogues": [
    {
      "id": "getting-dressed-d01",
      "titleEn": "Arms up!",
      "titleVi": "Giơ tay lên nào!",
      "lines": [
        {
          "speaker": "mom",
          "en": "Let's get dressed! Arms up!",
          "vi": "Mình thay đồ nha! Giơ tay lên nào!"
        },
        {
          "speaker": "child",
          "en": "I'm stuck!",
          "vi": "Con bị kẹt rồi!"
        },
        {
          "speaker": "mom",
          "en": "Peekaboo! Now put on your pants.", "ipa": "/ˈpikəbu naʊ pʊt ɑn jɔɹ pænts/",
          "vi": "Ú òa! Giờ mình mặc quần vào nào."
        },
        {
          "speaker": "child",
          "en": "By myself!",
          "vi": "Con tự làm!"
        },
        {
          "speaker": "mom",
          "en": "One leg in! You look great!",
          "vi": "Xỏ một chân vào nào! Con mặc đẹp quá!"
        },
        {
          "speaker": "child",
          "en": "Look at me!",
          "vi": "Nhìn con nè!"
        }
      ]
    },
    {
      "id": "getting-dressed-d02",
      "titleEn": "Which shirt?",
      "titleVi": "Chọn áo nào?",
      "lines": [
        {
          "speaker": "dad",
          "en": "Which shirt do you want?",
          "vi": "Con chọn áo nào?"
        },
        {
          "speaker": "child",
          "en": "Red one!",
          "vi": "Cái màu đỏ!"
        },
        {
          "speaker": "dad",
          "en": "Where are your shoes?",
          "vi": "Con ơi, giày của con đâu rồi?"
        },
        {
          "speaker": "child",
          "en": "Shoes on!",
          "vi": "Con mang giày rồi!"
        },
        {
          "speaker": "dad",
          "en": "Let's wear a jacket. Zip it up!",
          "vi": "Mình mặc áo khoác nha. Kéo khóa lên nào!"
        },
        {
          "speaker": "child",
          "en": "I'm ready!",
          "vi": "Con xong rồi!"
        }
      ]
    },
    {
      "id": "getting-dressed-d03",
      "titleEn": "Wrong foot!",
      "titleVi": "Mang lộn chân rồi!",
      "lines": [
        {
          "speaker": "dad",
          "en": "Sit down for your shoes.",
          "vi": "Con ngồi xuống mang giày nha."
        },
        {
          "speaker": "child",
          "en": "My shoes, please!",
          "vi": "Đưa giày cho con!"
        },
        {
          "speaker": "dad",
          "en": "Here you go! Can you do it yourself?",
          "vi": "Nè con! Con tự làm được không?"
        },
        {
          "speaker": "child",
          "en": "By myself!",
          "vi": "Con tự làm!"
        },
        {
          "speaker": "dad",
          "en": "Oops, wrong foot! Let's switch.",
          "vi": "Ối, mang lộn chân rồi! Mình đổi lại nha."
        },
        {
          "speaker": "child",
          "en": "This one!",
          "vi": "Cái này nè!"
        },
        {
          "speaker": "dad",
          "en": "Yes! You did it!",
          "vi": "Đúng rồi! Con giỏi quá!"
        }
      ]
    }
  ]
