  "dialogues": [
    {
      "id": "numbers-counting-d01",
      "titleEn": "Counting ducks",
      "titleVi": "Đếm vịt",
      "lines": [
        {
          "speaker": "dad",
          "en": "Look! How many ducks do you see?",
          "vi": "Nhìn kìa! Con thấy mấy con vịt?"
        },
        {
          "speaker": "child",
          "en": "Let me count!",
          "vi": "Để con đếm!"
        },
        {
          "speaker": "dad",
          "en": "Count them with your finger.",
          "vi": "Con lấy ngón tay chỉ từng con mà đếm nha."
        },
        {
          "speaker": "child",
          "en": "One, two, three!",
          "vi": "Một, hai, ba!"
        },
        {
          "speaker": "dad",
          "en": "Yes! There are three ducks!",
          "vi": "Đúng rồi! Có ba con vịt nè!"
        },
        {
          "speaker": "child",
          "en": "Three ducks!",
          "vi": "Ba con vịt!"
        }
      ]
    },
    {
      "id": "numbers-counting-d02",
      "titleEn": "How old are you?",
      "titleVi": "Con mấy tuổi?",
      "lines": [
        {
          "speaker": "mom",
          "en": "How old are you?",
          "vi": "Con mấy tuổi rồi?"
        },
        {
          "speaker": "child",
          "en": "I'm three!",
          "vi": "Con ba tuổi!"
        },
        {
          "speaker": "mom",
          "en": "Can you show me three fingers?",
          "vi": "Con giơ ba ngón tay coi nào?"
        },
        {
          "speaker": "child",
          "en": "Like this!",
          "vi": "Vầy nè!"
        },
        {
          "speaker": "mom",
          "en": "Wow, three fingers! Let's count to five!",
          "vi": "Oa, ba ngón tay! Mình đếm tới năm nha!"
        },
        {
          "speaker": "child",
          "en": "Five fingers!",
          "vi": "Năm ngón tay!"
        }
      ]
    },
    {
      "id": "numbers-counting-d03",
      "titleEn": "Counting stairs",
      "titleVi": "Đếm bậc thang",
      "lines": [
        {
          "speaker": "mom",
          "en": "Let's count the stairs as we walk up.",
          "vi": "Mình vừa leo cầu thang vừa đếm nha."
        },
        {
          "speaker": "child",
          "en": "Okay! One, two!",
          "vi": "Dạ! Một, hai!"
        },
        {
          "speaker": "dad",
          "en": "One more!",
          "vi": "Thêm một bậc nữa!"
        },
        {
          "speaker": "child",
          "en": "Three!",
          "vi": "Ba!"
        },
        {
          "speaker": "mom",
          "en": "Keep going! Count with me!",
          "vi": "Đếm tiếp nào! Mình cùng đếm nha!"
        },
        {
          "speaker": "child",
          "en": "Four, five, six!",
          "vi": "Bốn, năm, sáu!"
        },
        {
          "speaker": "dad",
          "en": "Wow, six stairs! Great counting!",
          "vi": "Oa, sáu bậc! Con đếm giỏi quá!"
        }
      ]
    }
