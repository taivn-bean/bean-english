        {
          "speaker": "dad",
          "en": "Yes! This one is red. Can you find something green?",
          "vi": "Đúng rồi! Cái này màu đỏ. Con tìm cái gì màu xanh lá được không?"
        },
        {
          "speaker": "child",
          "en": "Green like grass!",
          "vi": "Xanh lá như cỏ!"
        },
        {
          "speaker": "dad",
          "en": "Great job! The sky is blue and the grass is green.",
          "vi": "Giỏi quá! Bầu trời màu xanh dương, còn cỏ màu xanh lá."
        },
        {
          "speaker": "child",
          "en": "Blue sky!",
          "vi": "Trời xanh!"
        }
