  "dialogues": [
    {
      "id": "safety-d01",
      "titleEn": "Crossing the street",
      "titleVi": "Qua đường",
      "lines": [
        { "speaker": "dad", "en": "Stop and wait.", "vi": "Dừng lại, đợi chút nào." },
        { "speaker": "child", "en": "Stop!", "vi": "Dừng!" },
        { "speaker": "dad", "en": "Hold my hand to cross.", "vi": "Nắm tay ba để qua đường nha con." },
        { "speaker": "child", "en": "Hold my hand!", "vi": "Nắm tay con đi!" },
        { "speaker": "dad", "en": "Good stopping! Now we walk.", "vi": "Con dừng lại giỏi quá! Giờ mình đi nha." },
        { "speaker": "child", "en": "Walk, walk!", "vi": "Đi, đi!" }
      ]
    },
    {
      "id": "safety-d02",
      "titleEn": "The hot stove",
      "titleVi": "Bếp nóng",
      "lines": [
        { "speaker": "child", "en": "What's that?", "vi": "Cái gì vậy?" },
        { "speaker": "mom", "en": "It's hot. Let's wait.", "vi": "Nóng đó con. Mình đợi chút nha." },
        { "speaker": "child", "en": "Hot!", "vi": "Nóng!" },
        { "speaker": "mom", "en": "Yes, hot. Let's stay away from the stove.", "vi": "Ừ, nóng. Mình tránh xa bếp ra nha." },
        { "speaker": "child", "en": "Okay, Mommy.", "vi": "Dạ, mẹ." },
        { "speaker": "mom", "en": "Thank you! Let's play with your blocks.", "vi": "Cảm ơn con! Mình chơi đồ xếp hình nha." }
      ]
    },
    {
      "id": "safety-d03",
      "titleEn": "Going down the stairs",
      "titleVi": "Xuống cầu thang",
      "lines": [
        { "speaker": "mom", "en": "Hold the railing, please.", "vi": "Vịn tay vịn nha con." },
        { "speaker": "child", "en": "Okay, Mommy.", "vi": "Dạ, mẹ." },
        { "speaker": "mom", "en": "One step at a time.", "vi": "Đi từng bậc một nha con." },
        { "speaker": "child", "en": "Step, step!", "vi": "Bước, bước!" },
        { "speaker": "mom", "en": "Good job! Last step!", "vi": "Giỏi quá! Bậc cuối rồi!" },
        { "speaker": "child", "en": "I did it!", "vi": "Con làm được rồi!" }
      ]
    }
  ]
}
