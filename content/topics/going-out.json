    { "id": "going-out-029", "speaker": "child", "level": 1, "en": "Can I push?", "vi": "Cho con bấm nha?" },
    { "id": "going-out-030", "speaker": "child", "level": 1, "en": "Big puddle!", "vi": "Vũng nước bự quá!" },
    { "id": "going-out-031", "speaker": "parent", "level": 2, "en": "Let's put on sunscreen.", "vi": "Mình thoa kem chống nắng nha." },
    { "id": "going-out-032", "speaker": "parent", "level": 3, "en": "Red light, stop! Green light, go!", "vi": "Đèn đỏ thì dừng! Đèn xanh thì đi!" },
