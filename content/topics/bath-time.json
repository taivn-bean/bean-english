        },
        {
          "speaker": "child",
          "en": "Splash!",
          "vi": "Té nè!"
        },
        {
          "speaker": "mom",
          "en": "Gentle splashes, please.",
          "vi": "Té nước nhẹ thôi nha con."
        },
        {
          "speaker": "child",
          "en": "Duck, please!",
          "vi": "Cho con con vịt!"
        },
        {
          "speaker": "mom",
          "en": "Here's your duck!",
          "vi": "Con vịt của con nè!"
        }
      ],
      "ages": [
        "3-5"
