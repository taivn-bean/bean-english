    {
      "id": "getting-dressed-d01",
      "titleEn": "Arms up!",
      "titleVi": "Giơ tay lên nào!",
      "lines": [
        {
          "speaker": "mom",
          "en": "Let's get dressed! Arms up!",
          "vi": "Mình thay đồ nha! Giơ tay lên nào!"
        },
        {
          "speaker": "child",
          "en": "I'm stuck!",
          "vi": "Con bị kẹt rồi!"
        },
        {
          "speaker": "mom",
          "en": "Peekaboo! Now put on your pants.",
          "ipa": "/ˈpikəbu naʊ pʊt ɑn jɔɹ pænts/",
          "vi": "Ú òa! Giờ mình mặc quần vào nào."
        },
        {
          "speaker": "child",
          "en": "By myself!",
          "vi": "Con tự làm!"
        },
        {
          "speaker": "mom",
          "en": "One leg in! You look great!",
          "vi": "Xỏ một chân vào nào! Con mặc đẹp quá!"
        },
        {
          "speaker": "child",
          "en": "Look at me!",
          "vi": "Nhìn con nè!"
