  "dialogues": [
    {
      "id": "wake-up-d01",
      "titleEn": "Good morning, sweetie",
      "titleVi": "Chào buổi sáng con yêu",
      "lines": [
        {
          "speaker": "mom",
          "en": "Good morning! Wake up, sweetie!",
          "vi": "Chào buổi sáng! Dậy thôi con yêu!"
        },
        {
          "speaker": "child",
          "en": "I'm sleepy.",
          "vi": "Con buồn ngủ."
        },
        {
          "speaker": "mom",
          "en": "Big stretch! Open your eyes!",
          "vi": "Vươn vai thật dài nào! Mở mắt ra nào con!"
        },
        {
          "speaker": "child",
          "en": "Not yet!",
          "vi": "Chưa đâu!"
        },
        {
          "speaker": "mom",
          "en": "Give me a big hug!",
          "vi": "Ôm mẹ một cái thật chặt nào!"
        },
        {
          "speaker": "child",
          "en": "I'm up!",
          "vi": "Con dậy rồi!"
        }
      ]
    },
    {
      "id": "wake-up-d02",
      "titleEn": "Sunny morning",
      "titleVi": "Buổi sáng đầy nắng",
      "lines": [
        {
          "speaker": "dad",
          "en": "Did you sleep well?",
          "vi": "Con ngủ có ngon không?"
        },
        {
          "speaker": "child",
          "en": "Yes!",
          "vi": "Dạ có!"
        },
        {
          "speaker": "dad",
          "en": "Let's open the curtains! Look, it's sunny!",
          "vi": "Mình mở rèm ra nào! Con nhìn nè, trời nắng quá!"
        },
        {
          "speaker": "child",
          "en": "Where's Teddy?",
          "vi": "Gấu bông đâu rồi?"
        },
        {
          "speaker": "dad",
          "en": "Here! Say good morning to Mommy.",
          "vi": "Đây nè! Con chào mẹ đi nào!"
        },
        {
          "speaker": "child",
          "en": "Good morning, Mommy!",
          "vi": "Con chào mẹ ạ!"
        }
      ]
    },
    {
      "id": "wake-up-d03",
      "titleEn": "Messy hair morning",
      "titleVi": "Buổi sáng tóc rối",
      "lines": [
        {
          "speaker": "dad",
          "en": "Rise and shine! Your hair is so messy this morning!",
          "vi": "Dậy thôi, nắng lên rồi con! Sáng nay tóc con rối quá!"
        },
        {
          "speaker": "child",
          "en": "Hug me, please!",
          "vi": "Ôm con với!"
        },
        {
          "speaker": "dad",
          "en": "Okay! Do you want milk first?",
          "vi": "Được rồi! Con muốn uống sữa trước không?"
        },
        {
          "speaker": "child",
          "en": "Milk, please!",
          "vi": "Cho con sữa với!"
        },
        {
          "speaker": "dad",
          "en": "Here you go! Now let's make the bed together.",
          "vi": "Đây nè! Giờ mình cùng dọn giường nha."
        },
        {
          "speaker": "child",
          "en": "Okay!",
          "vi": "Dạ!"
        }
      ]
    }
  ]
