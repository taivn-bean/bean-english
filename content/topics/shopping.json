        {
          "speaker": "child",
          "en": "Milk! Can I get it?",
          "vi": "Sữa! Con lấy nha?"
        },
        {
          "speaker": "mom",
          "en": "Sure. Grab the big one, please.",
          "vi": "Ừ. Lấy hộp lớn nha con."
        },
        {
          "speaker": "child",
          "en": "Got it! It's heavy.",
          "vi": "Lấy rồi! Nặng quá."
        },
        {
          "speaker": "mom",
          "en": "Thanks! Now can you cross the milk off the list?",
          "vi": "Cảm ơn con! Giờ con gạch sữa ra khỏi danh sách nha."
        },
        {
