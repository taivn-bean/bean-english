  "dialogues": [
    {
      "id": "greetings-manners-d01",
      "titleEn": "Visiting Grandma",
      "titleVi": "Thăm bà",
      "lines": [
        {
          "speaker": "dad",
          "en": "Look, Grandma is here! Say hi to Grandma.",
          "vi": "Bà tới rồi kìa! Con chào bà đi nào."
        },
        {
          "speaker": "child",
          "en": "Hello, Grandma!",
          "vi": "Con chào bà!"
        },
        {
          "speaker": "dad",
          "en": "Such nice manners!",
          "vi": "Con lễ phép giỏi quá!"
        },
        {
          "speaker": "dad",
          "en": "Grandma has a cookie for you. What do you say?",
          "vi": "Bà cho con bánh nè. Con phải nói gì ta?"
        },
        {
          "speaker": "child",
          "en": "Thank you, Grandma!",
          "vi": "Con cảm ơn bà!"
        },
        {
          "speaker": "dad",
          "en": "Good job saying thank you!",
          "vi": "Con biết nói cảm ơn, giỏi quá!"
        }
      ]
    },
    {
      "id": "greetings-manners-d02",
      "titleEn": "Sharing with a friend",
      "titleVi": "Chia đồ chơi với bạn",
      "lines": [
        {
          "speaker": "mom",
          "en": "Your friend wants a turn. Let's share with your friend.",
          "vi": "Bạn muốn chơi kìa. Mình chia cho bạn với nha."
        },
        {
          "speaker": "child",
          "en": "Okay!",
          "vi": "Dạ!"
        },
        {
          "speaker": "mom",
          "en": "Thank you for sharing!",
          "vi": "Cảm ơn con đã chia sẻ nha!"
        },
        {
          "speaker": "child",
          "en": "My turn?",
          "vi": "Tới con chưa mẹ?"
        },
        {
          "speaker": "mom",
          "en": "Wait your turn, please.",
          "vi": "Con chờ tới lượt mình nha."
        },
        {
          "speaker": "child",
          "en": "Okay, Mommy.",
          "vi": "Dạ, mẹ."
        }
      ]
    },
    {
      "id": "greetings-manners-d03",
      "titleEn": "Saying goodbye",
      "titleVi": "Chào tạm biệt",
      "lines": [
        {
          "speaker": "mom",
          "en": "Time to go home. Say bye-bye to your teacher.",
          "vi": "Tới giờ về rồi. Con chào cô giáo đi nào."
        },
        {
          "speaker": "child",
          "en": "Bye, teacher!",
          "vi": "Tạm biệt cô!"
        },
        {
          "speaker": "dad",
          "en": "Can you say thank you, too?",
          "vi": "Con cảm ơn cô nữa được không?"
        },
        {
          "speaker": "child",
          "en": "Thank you, teacher!",
          "vi": "Con cảm ơn cô!"
        },
        {
          "speaker": "mom",
          "en": "Such nice manners!",
          "vi": "Con lễ phép giỏi quá!"
        }
      ]
    }
  ]
