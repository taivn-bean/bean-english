        },
        {
          "speaker": "child",
          "en": "Teddy, please!",
          "vi": "Cho con gấu bông!"
        },
        {
          "speaker": "mom",
          "en": "Here's your teddy. Sweet dreams!",
          "vi": "Gấu bông nè. Ngủ ngon, mơ đẹp nha!"
        }
      ],
      "ages": [
