      "speaker": "parent",
      "level": 2,
      "en": "Time for your medicine.",
      "vi": "Tới giờ uống thuốc rồi con."
    },
    {
      "id": "feeling-sick-006",
      "speaker": "parent",
      "level": 2,
      "en": "You need lots of ___.",
      "vi": "Con cần ___ thật nhiều nha.",
      "slots": [
        {
          "en": "rest",
          "vi": "nghỉ ngơi"
        },
        {
          "en": "water",
          "vi": "uống nước"
        },
        {
          "en": "sleep",
          "vi": "ngủ"
        },
        {
          "en": "hugs",
          "vi": "được ôm"
        }
      ]
    },
    {
      "id": "feeling-sick-007",
      "speaker": "parent",
      "level": 2,
      "en": "Have a little ___.",
      "vi": "Con ___ một chút nha.",
      "slots": [
        {
          "en": "water",
          "vi": "uống nước"
        },
        {
          "en": "juice",
          "vi": "uống nước trái cây"
        },
        {
          "en": "soup",
          "vi": "ăn súp"
        },
        {
          "en": "medicine",
          "vi": "uống thuốc"
        }
      ]
    },
    {
      "id": "feeling-sick-008",
      "speaker": "parent",
      "level": 2,
      "en": "Cuddle up with your ___.",
      "vi": "Ôm ___ của con nè.",
      "slots": [
        {
          "en": "teddy",
          "vi": "gấu bông"
        },
        {
          "en": "blanket",
          "vi": "cái mền"
        },
        {
          "en": "bunny",
          "vi": "thỏ bông"
        }
      ]
    },
    {
      "id": "feeling-sick-009",
      "speaker": "parent",
      "level": 1,
      "en": "Oh, poor sweetie.",
      "vi": "Ôi, thương con quá."
    },
    {
      "id": "feeling-sick-010",
      "speaker": "parent",
      "level": 2,
      "en": "You'll feel better soon.",
      "vi": "Con sẽ khỏe lại sớm thôi."
    },
    {
      "id": "feeling-sick-011",
      "speaker": "parent",
      "level": 2,
      "en": "I'm here with you.",
      "vi": "Ở bên con đây nè."
    },
    {
      "id": "feeling-sick-012",
      "speaker": "parent",
      "level": 2,
      "en": "The doctor will help you.",
      "vi": "Bác sĩ sẽ giúp con khỏe lại."
    },
    {
      "id": "feeling-sick-013",
      "speaker": "parent",
      "level": 2,
      "en": "Cover your cough, please.",
      "vi": "Ho thì che miệng lại nha con."
    },
    {
      "id": "feeling-sick-014",
      "speaker": "parent",
      "level": 2,
      "en": "Do you need a ___?",
