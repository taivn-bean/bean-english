    {"id":"v-actions-044","en":"bite","vi":"cắn","pos":"verb","ages":["3-5","5-7"],"examples":[{"en":"One big bite!","vi":"Cắn một miếng to nào!"},{"en":"Can you take a little bite?","vi":"Con cắn thử một miếng nhỏ được không?"},{"en":"Bite your apple, not your friend.","vi":"Cắn trái táo, không cắn bạn nha."},{"en":"Ouch, biting hurts.","vi":"Á, bị cắn đau lắm."},{"en":"I took a big bite!","vi":"Con cắn một miếng to luôn!"}]},
    {"id":"v-actions-045","en":"put","vi":"đặt, để","pos":"verb","ages":["3-5","5-7"],"examples":[{"en":"Put it here!","vi":"Để ở đây nè!"},{"en":"Where did you put your shoes?","vi":"Con để giày ở đâu rồi?"},{"en":"Put your toys in the box.","vi":"Con cất đồ chơi vô hộp nha."},{"en":"You put it in the right spot!","vi":"Con để đúng chỗ rồi!"},{"en":"I put my bag away!","vi":"Con cất cặp rồi!"}]},
    {"id":"v-actions-046","en":"get","vi":"lấy","pos":"verb","ages":["3-5","5-7"],"examples":[{"en":"Go get your shoes!","vi":"Đi lấy giày đi con!"},{"en":"Can you get me a cup?","vi":"Con lấy giùm mình cái ly được không?"},{"en":"Let's get some water.","vi":"Mình đi lấy nước nha."},{"en":"You got it by yourself!","vi":"Con tự lấy được rồi!"},{"en":"Can I get down now?","vi":"Con xuống được chưa?"}]},
    {"id":"v-actions-047","en":"see","vi":"thấy","pos":"verb","ages":["3-5","5-7"],"examples":[{"en":"I see you!","vi":"Thấy con rồi nha!"},{"en":"What do you see?","vi":"Con thấy gì?"},{"en":"Come see the fish!","vi":"Lại coi cá nè!"},{"en":"Nice to see you again!","vi":"Gặp lại con vui ghê!"},{"en":"I saw a big truck!","vi":"Con thấy một chiếc xe tải bự!"}]},
    {"id":"v-actions-048","en":"talk","vi":"nói chuyện","pos":"verb","emoji":"🗣️","ages":["3-5","5-7"],"examples":[{"en":"Let's talk about it.","vi":"Mình nói chuyện về chuyện đó nha."},{"en":"Who are you talking to?","vi":"Con đang nói chuyện với ai vậy?"},{"en":"Talk quietly, please. Baby's asleep.","vi":"Nói nhỏ thôi con. Em bé đang ngủ."},{"en":"You talk so clearly now!","vi":"Giờ con nói rõ ghê!"},{"en":"I talked to Grandma on the phone!","vi":"Con nói chuyện điện thoại với bà rồi!"}]},
    {"id":"v-actions-049","en":"bring","vi":"mang tới, đem","pos":"verb","ages":["3-5","5-7"],"examples":[{"en":"Bring it here!","vi":"Đem lại đây nè!"},{"en":"Can you bring me a diaper?","vi":"Con lấy giùm mình cái tã được không?"},{"en":"Bring your cup to the table.","vi":"Đem ly ra bàn đi con."},{"en":"Thanks for bringing that!","vi":"Cảm ơn con đã đem lại nha!"},{"en":"I brought you a rock!","vi":"Con đem cho cục đá nè!"}]},
    {"id":"v-actions-050","en":"show","vi":"chỉ cho xem","pos":"verb","ages":["3-5","5-7"],"examples":[{"en":"Show me!","vi":"Cho mình coi với!"},{"en":"Can you show me your drawing?","vi":"Con cho mình coi tranh được không?"},{"en":"Show Daddy your new shoes.","vi":"Cho ba coi đôi giày mới đi con."},{"en":"Thanks for showing me!","vi":"Cảm ơn con đã cho mình coi!"},{"en":"Let me show you!","vi":"Để con chỉ cho coi!"}]},
