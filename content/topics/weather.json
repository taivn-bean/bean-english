    {
      "id": "weather-d01",
      "titleEn": "Rainy day",
      "titleVi": "Trời mưa",
      "lines": [
        {
          "speaker": "mom",
          "en": "Look outside!",
          "vi": "Nhìn ra ngoài kìa con!"
        },
        {
          "speaker": "child",
          "en": "It's raining!",
          "vi": "Mưa rồi!"
        },
        {
          "speaker": "mom",
          "en": "Let's take your umbrella.",
          "vi": "Mình mang theo cây dù của con nha."
        },
        {
          "speaker": "child",
          "en": "Umbrella, please!",
          "vi": "Cho con cây dù!"
        },
        {
          "speaker": "mom",
          "en": "Here you go! Let's jump in the puddles!",
          "vi": "Nè con! Mình nhảy vũng nước nào!"
        },
        {
          "speaker": "child",
          "en": "Jump, jump!",
          "vi": "Nhảy, nhảy!"
        }
      ]
    },
    {
      "id": "weather-d02",
