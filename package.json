  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs --strict && vite build && tsc -b",
    "preview": "vite preview",
    "lint": "oxlint",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --strict",
    "audio": "node scripts/build-content.mjs && node scripts/gen-audio.mjs && node scripts/build-content.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "test:offline": "node tests/offline-smoke.mjs",
    "audio:compact": "node scripts/build-content.mjs && node scripts/gen-audio.mjs --compact && node scripts/build-content.mjs",
    "test:push": "node tests/webpush.test.ts",
    "worker:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^27.2.3",
    "lucide-react": "^1.77.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "http_ece": "^1.2.1",
    "kokoro-js": "^1.2.1",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.166.0"
  }
