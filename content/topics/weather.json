      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "weather-d04",
      "titleEn": "Waiting for the rain to stop",
      "titleVi": "Chờ mưa tạnh",
      "lines": [
        {
          "speaker": "child",
          "en": "Can we go to the park now?",
          "vi": "Mình đi công viên được không mẹ?"
        },
        {
          "speaker": "mom",
          "en": "Hmm, look outside. What do you see?",
          "vi": "Ừm, con nhìn ra ngoài coi. Con thấy gì?"
        },
        {
          "speaker": "child",
          "en": "Dark clouds. And it's windy.",
          "vi": "Mây đen. Với gió nữa."
        },
        {
          "speaker": "mom",
          "en": "Right. It looks like it's going to rain.",
          "vi": "Đúng rồi. Coi bộ trời sắp mưa."
        },
        {
          "speaker": "child",
          "en": "But I want to go!",
          "vi": "Nhưng con muốn đi mà!"
        },
        {
          "speaker": "mom",
          "en": "I know. We can go when the rain stops.",
          "vi": "Mẹ biết. Mưa tạnh rồi mình đi nha."
        },
        {
