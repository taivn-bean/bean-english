  "dialogues": [
    {
      "id": "feeling-sick-d01",
      "titleEn": "Tummy ache",
      "titleVi": "Đau bụng",
      "lines": [
        {
          "speaker": "child",
          "en": "My tummy hurts.",
          "vi": "Con đau bụng."
        },
        {
          "speaker": "mom",
          "en": "Oh, poor sweetie. Show me where it hurts.",
          "vi": "Ôi, thương con quá. Chỉ mẹ coi đau chỗ nào nè."
        },
        {
          "speaker": "child",
          "en": "Right here.",
          "vi": "Chỗ này nè."
        },
        {
          "speaker": "mom",
          "en": "Cuddle up with your teddy. You need lots of rest.",
          "vi": "Ôm gấu bông của con nè. Con cần nghỉ ngơi thật nhiều nha."
        },
        {
          "speaker": "child",
          "en": "Hold me, please.",
          "vi": "Ôm con đi mẹ."
        },
        {
          "speaker": "mom",
          "en": "Come here. You'll feel better soon.",
          "vi": "Lại đây con. Con sẽ khỏe lại sớm thôi."
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "feeling-sick-d02",
      "titleEn": "Medicine time",
      "titleVi": "Giờ uống thuốc",
      "lines": [
        {
          "speaker": "dad",
          "en": "You feel a little warm.",
          "vi": "Người con hơi ấm ấm nè."
        },
        {
          "speaker": "child",
          "en": "I don't feel good.",
          "vi": "Con thấy không khỏe."
        },
        {
          "speaker": "dad",
          "en": "Time for your medicine. Open up!",
          "vi": "Tới giờ uống thuốc rồi con. Há miệng nào!"
        },
        {
          "speaker": "child",
          "en": "Gulp!",
          "vi": "Ực!"
        },
        {
          "speaker": "dad",
          "en": "Good job! Have a little water.",
          "vi": "Giỏi quá! Con uống nước một chút nha."
        },
        {
          "speaker": "child",
          "en": "All gone!",
          "vi": "Hết rồi!"
        }
      ],
      "ages": [
        "3-5"
      ]
    },
    {
      "id": "feeling-sick-d03",
      "titleEn": "Feeling better",
      "titleVi": "Khỏe hơn rồi",
      "lines": [
        {
          "speaker": "child",
          "en": "Achoo!",
          "vi": "Hắt xì!"
        },
        {
          "speaker": "dad",
          "en": "Bless you! Do you need a tissue?",
          "vi": "Ôi, hắt xì rồi! Con có cần khăn giấy không?"
        },
        {
          "speaker": "child",
          "en": "Tissue, please.",
          "vi": "Cho con khăn giấy."
        },
        {
          "speaker": "dad",
          "en": "Here you go. How do you feel?",
          "vi": "Nè con. Con thấy sao rồi?"
        },
        {
          "speaker": "child",
          "en": "I'm feeling better!",
          "vi": "Con đỡ rồi!"
        },
        {
          "speaker": "dad",
          "en": "Yay! I'm so happy!",
          "vi": "Hoan hô! Ba vui quá!"
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "feeling-sick-d04",
      "titleEn": "Staying home",
      "titleVi": "Ở nhà nghỉ",
      "lines": [
        {
          "speaker": "child",
          "en": "Mommy, my tummy feels funny.",
          "vi": "Mẹ ơi, bụng con thấy khó chịu."
        },
        {
          "speaker": "mom",
          "en": "Oh no. Do you feel like you're going to throw up?",
          "vi": "Ôi. Con thấy muốn ói không?"
        },
        {
          "speaker": "child",
          "en": "No. It just hurts a little.",
          "vi": "Không. Chỉ hơi đau thôi."
        },
        {
          "speaker": "mom",
          "en": "Okay. You're staying home today. Let's rest on the couch.",
          "vi": "Ừ. Hôm nay con ở nhà nha. Mình nằm nghỉ trên ghế sofa."
        },
        {
          "speaker": "child",
          "en": "Can I watch a show?",
          "vi": "Con xem phim được không?"
        },
        {
          "speaker": "mom",
          "en": "Sure, just one. And sip some water, okay?",
          "vi": "Được, một tập thôi nha. Uống chút nước nữa nha con."
        },
        {
