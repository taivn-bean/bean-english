  "dialogues": [
    {
      "id": "weather-d01",
      "titleEn": "Rainy day",
      "titleVi": "Trời mưa",
      "lines": [
        {
          "speaker": "mom",
          "en": "Look outside!",
          "vi": "Nhìn ra ngoài kìa con!"
        },
        {
          "speaker": "child",
          "en": "It's raining!",
          "vi": "Mưa rồi!"
        },
        {
          "speaker": "mom",
          "en": "Let's take your umbrella.",
          "vi": "Mình mang theo cây dù của con nha."
        },
        {
          "speaker": "child",
          "en": "Umbrella, please!",
          "vi": "Cho con cây dù!"
        },
        {
          "speaker": "mom",
          "en": "Here you go! Let's jump in the puddles!",
          "vi": "Nè con! Mình nhảy vũng nước nào!"
        },
        {
          "speaker": "child",
          "en": "Jump, jump!",
          "vi": "Nhảy, nhảy!"
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "weather-d02",
      "titleEn": "Thunder",
      "titleVi": "Sấm sét",
      "lines": [
        {
          "speaker": "dad",
          "en": "Can you hear the thunder?",
          "vi": "Con có nghe tiếng sấm không?"
        },
        {
          "speaker": "child",
          "en": "So loud!",
          "vi": "To quá!"
        },
        {
          "speaker": "dad",
          "en": "It's just thunder.",
          "vi": "Chỉ là tiếng sấm thôi con."
        },
        {
          "speaker": "child",
          "en": "Hug, Daddy!",
          "vi": "Ôm con đi ba!"
        },
        {
          "speaker": "dad",
          "en": "Big hug! You're safe inside with me.",
          "vi": "Ba ôm con nè! Con ở trong nhà với ba, an toàn mà."
        },
        {
          "speaker": "child",
          "en": "I'm okay.",
          "vi": "Con không sao."
        }
      ],
      "ages": [
        "3-5"
      ]
    },
    {
      "id": "weather-d03",
      "titleEn": "Sunny day",
      "titleVi": "Trời nắng",
      "lines": [
        {
          "speaker": "dad",
          "en": "What's the weather like?",
          "vi": "Trời hôm nay sao vậy con?"
        },
        {
          "speaker": "child",
          "en": "Sunny!",
          "vi": "Nắng!"
        },
        {
          "speaker": "dad",
          "en": "Wear your hat. It's sunny.",
          "vi": "Đội nón vào nha, trời nắng đó."
        },
        {
          "speaker": "child",
          "en": "Hat on!",
          "vi": "Đội rồi!"
        },
        {
          "speaker": "dad",
          "en": "Look at the birds in the sky!",
          "vi": "Nhìn mấy con chim trên trời kìa!"
        },
        {
          "speaker": "child",
          "en": "Hi, birdie!",
          "vi": "Chào chim nhỏ!"
