  "dialogues": [
    {
      "id": "daily-talk-d01",
      "titleEn": "Look at me!",
      "titleVi": "Nhìn con nè!",
      "lines": [
        {
          "speaker": "child",
          "en": "Look, Daddy!",
          "vi": "Ba ơi, nhìn nè!"
        },
        {
          "speaker": "dad",
          "en": "Just a minute. Almost done!",
          "vi": "Chờ xíu nha con. Ba sắp xong rồi!"
        },
        {
          "speaker": "child",
          "en": "Come and see!",
          "vi": "Lại đây xem nè!"
        },
        {
          "speaker": "dad",
          "en": "I'm coming! Wow, that's funny!",
          "vi": "Ba tới liền đây! Oa, buồn cười quá ha!"
        },
        {
          "speaker": "child",
          "en": "Again, again!",
          "vi": "Nữa đi, nữa đi!"
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "daily-talk-d02",
      "titleEn": "Help, please",
      "titleVi": "Giúp con với",
      "lines": [
        {
          "speaker": "child",
          "en": "Mommy, help!",
          "vi": "Mẹ ơi, giúp con!"
        },
        {
          "speaker": "mom",
          "en": "What's wrong, sweetie? Are you all right?",
          "vi": "Sao vậy con? Con có sao không?"
        },
        {
          "speaker": "child",
          "en": "I need water.",
          "vi": "Con cần nước."
        },
        {
          "speaker": "mom",
          "en": "Wait a moment, please. I'm coming!",
          "vi": "Con đợi một chút nha. Mẹ tới liền đây!"
        },
        {
          "speaker": "child",
          "en": "Okay!",
          "vi": "Dạ!"
        },
        {
          "speaker": "mom",
          "en": "Here you go. Thank you for waiting.",
          "vi": "Nước nè con. Cảm ơn con đã chờ nha."
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "daily-talk-d03",
      "titleEn": "Your turn!",
      "titleVi": "Tới lượt con!",
      "lines": [
        {
          "speaker": "dad",
          "en": "Do you want to play with me?",
          "vi": "Con muốn chơi chung với ba không?"
        },
        {
          "speaker": "child",
          "en": "Yes!",
          "vi": "Dạ có!"
        },
        {
          "speaker": "dad",
          "en": "Okay! Now it's your turn.",
          "vi": "Được nè! Giờ tới lượt con nha."
        },
        {
          "speaker": "child",
          "en": "Look, Daddy!",
          "vi": "Ba ơi, nhìn nè!"
        },
        {
          "speaker": "dad",
          "en": "Good try! Try again.",
          "vi": "Con cố gắng giỏi lắm! Thử lại nha."
        },
        {
          "speaker": "child",
          "en": "Again, again!",
          "vi": "Nữa đi, nữa đi!"
        },
        {
          "speaker": "dad",
          "en": "You can do it!",
          "vi": "Con làm được mà!"
        }
      ],
      "ages": [
        "3-5"
      ]
    },
    {
      "id": "daily-talk-d04",
      "titleEn": "Excuse me",
      "titleVi": "Xin phép trước",
      "lines": [
        {
          "speaker": "child",
          "en": "Mommy! Mommy! Look!",
          "vi": "Mẹ ơi! Mẹ ơi! Nhìn nè!"
        },
        {
          "speaker": "mom",
          "en": "Hang on a sec, sweetie. I'm talking to Grandma.",
          "vi": "Chờ mẹ xíu nha con. Mẹ đang nói chuyện với bà."
        },
        {
          "speaker": "child",
          "en": "But it's important!",
          "vi": "Nhưng chuyện quan trọng mà!"
        },
        {
          "speaker": "mom",
          "en": "If you need me, just say \"Excuse me,\" and wait.",
          "vi": "Cần gì thì con nói \"xin lỗi\" rồi chờ nha."
        },
        {
          "speaker": "child",
          "en": "Excuse me, Mommy.",
          "vi": "Mẹ ơi, cho con xin lỗi."
        },
        {
          "speaker": "mom",
          "en": "Thank you for waiting. What is it?",
          "vi": "Cảm ơn con đã chờ. Chuyện gì vậy con?"
        },
        {
          "speaker": "child",
          "en": "I made a paper airplane! Can I fly it?",
          "vi": "Con xếp được máy bay giấy nè! Con phóng thử được không?"
        },
        {
          "speaker": "mom",
          "en": "Wow, nice! Sure, fly it in the living room.",
          "vi": "Oa, đẹp quá! Được, con phóng trong phòng khách nha."
        }
      ],
      "ages": [
        "5-7"
      ]
    },
    {
      "id": "daily-talk-d05",
      "titleEn": "Give me a hand",
      "titleVi": "Phụ một tay",
      "lines": [
        {
          "speaker": "dad",
          "en": "Hey, can you give me a hand? I'm making dinner.",
          "vi": "Nè con, phụ ba một tay được không? Ba đang nấu cơm."
        },
        {
          "speaker": "child",
          "en": "Hold on, I'm almost done with my drawing.",
          "vi": "Chờ xíu, con sắp vẽ xong rồi."
        },
        {
          "speaker": "dad",
          "en": "Okay. Come help when you're done, alright?",
          "vi": "Ừ. Vẽ xong thì vô phụ nha."
        },
        {
          "speaker": "child",
          "en": "I'm done. What should I do?",
          "vi": "Con xong rồi. Con làm gì đây ba?"
        },
        {
          "speaker": "dad",
          "en": "Can you wash the vegetables for me?",
          "vi": "Con rửa rau giùm ba nha?"
        },
        {
          "speaker": "child",
          "en": "Sure. Dad, can I ask you something?",
          "vi": "Dạ. Ba ơi, con hỏi cái này nha?"
        },
        {
          "speaker": "dad",
          "en": "Of course. What's up?",
          "vi": "Ừ, hỏi đi. Gì vậy con?"
        },
        {
          "speaker": "child",
          "en": "Why do onions make you cry?",
          "vi": "Sao cắt hành lại bị chảy nước mắt vậy?"
        },
        {
          "speaker": "dad",
          "en": "That's a great question. Let's look it up after dinner.",
          "vi": "Câu hỏi hay đó. Ăn xong mình cùng tìm hiểu nha."
        },
        {
          "speaker": "child",
          "en": "Okay! I'll set the table too.",
          "vi": "Dạ! Con dọn bàn luôn nha."
        },
        {
          "speaker": "dad",
          "en": "Wow, thanks! You're a big help.",
          "vi": "Oa, cảm ơn con! Con phụ ba nhiều lắm đó."
        }
      ],
      "ages": [
        "7-9"
      ]
    }
  ]
