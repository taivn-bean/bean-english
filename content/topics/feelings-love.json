  "dialogues": [
    {
      "id": "feelings-love-d01",
      "titleEn": "Feeling sad",
      "titleVi": "Khi con buồn",
      "lines": [
        { "speaker": "mom", "en": "Are you sad?", "vi": "Con buồn hả?" },
        { "speaker": "child", "en": "Yes. Sad.", "vi": "Dạ. Buồn." },
        { "speaker": "mom", "en": "It's okay to cry. Big hug!", "vi": "Khóc cũng được mà con. Ôm một cái nào!" },
        { "speaker": "child", "en": "Hug, please!", "vi": "Ôm con đi!" },
        { "speaker": "mom", "en": "Take a deep breath.", "vi": "Hít thở thật sâu nào." },
        { "speaker": "child", "en": "I'm okay now.", "vi": "Con hết buồn rồi." },
        { "speaker": "mom", "en": "I love you!", "vi": "Mẹ thương con lắm!" }
      ]
    },
    {
      "id": "feelings-love-d02",
      "titleEn": "Love you, Daddy",
      "titleVi": "Thương ba",
      "lines": [
        { "speaker": "dad", "en": "Can I have a kiss?", "vi": "Cho ba thơm một cái nào?" },
        { "speaker": "child", "en": "Okay!", "vi": "Dạ!" },
        { "speaker": "dad", "en": "I love you so much!", "vi": "Ba thương con nhiều lắm!" },
        { "speaker": "child", "en": "Me too!", "vi": "Con cũng vậy!" },
        { "speaker": "dad", "en": "Show me a happy face!", "vi": "Làm mặt vui cho ba xem nào!" },
        { "speaker": "child", "en": "Happy face!", "vi": "Mặt vui nè!" }
      ]
    },
    {
      "id": "feelings-love-d03",
      "titleEn": "Scared of thunder",
      "titleVi": "Sợ tiếng sấm",
      "lines": [
        { "speaker": "child", "en": "Daddy! Thunder!", "vi": "Ba ơi! Sấm!" },
        { "speaker": "dad", "en": "Did the thunder scare you?", "vi": "Con sợ tiếng sấm hả?" },
        { "speaker": "child", "en": "Yes. Scared.", "vi": "Dạ. Sợ." },
        { "speaker": "dad", "en": "I'm right here. Do you need a hug?", "vi": "Có ba đây rồi. Con muốn được ôm không?" },
        { "speaker": "child", "en": "Hug, please!", "vi": "Ôm con đi!" },
        { "speaker": "dad", "en": "Let's take a deep breath together.", "vi": "Mình cùng hít thở thật sâu nha." },
        { "speaker": "child", "en": "I'm okay now.", "vi": "Con hết sợ rồi." },
        { "speaker": "dad", "en": "You're so brave!", "vi": "Con dũng cảm quá!" }
      ]
    }
  ]
