  "dialogues": [
    {
      "id": "bath-time-d01",
      "titleEn": "Into the tub",
      "titleVi": "Vô bồn tắm",
      "lines": [
        { "speaker": "mom", "en": "Time for a bath!", "vi": "Tới giờ tắm rồi!" },
        { "speaker": "child", "en": "Bubbles!", "vi": "Bong bóng!" },
        { "speaker": "mom", "en": "Clothes off, please. In you go!", "vi": "Cởi đồ ra nha con. Vô bồn nào!" },
        { "speaker": "child", "en": "Splash!", "vi": "Té nè!" },
        { "speaker": "mom", "en": "Gentle splashes, please.", "vi": "Té nước nhẹ thôi nha con." },
        { "speaker": "child", "en": "Duck, please!", "vi": "Cho con con vịt!" },
        { "speaker": "mom", "en": "Here's your duck!", "vi": "Con vịt của con nè!" }
      ]
    },
    {
      "id": "bath-time-d02",
      "titleEn": "Washing hair",
      "titleVi": "Gội đầu",
      "lines": [
        { "speaker": "dad", "en": "Time to wash your hair.", "vi": "Gội đầu nha con." },
        { "speaker": "child", "en": "Okay, Daddy.", "vi": "Dạ, ba." },
        { "speaker": "dad", "en": "Close your eyes, please.", "vi": "Nhắm mắt lại nha con." },
        { "speaker": "child", "en": "Eyes closed!", "vi": "Nhắm rồi!" },
        { "speaker": "dad", "en": "All clean! Now it's time to get out.", "vi": "Sạch rồi! Mình ra thôi nha." },
        { "speaker": "child", "en": "Towel, please!", "vi": "Cho con cái khăn!" },
        { "speaker": "dad", "en": "You smell so nice!", "vi": "Con thơm quá!" }
      ]
