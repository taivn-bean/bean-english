  "dialogues": [
    {
      "id": "going-out-d01",
      "titleEn": "Going to the park",
      "titleVi": "Đi công viên",
      "lines": [
        { "speaker": "mom", "en": "Let's go to the park!", "vi": "Mình đi công viên nha!" },
        { "speaker": "child", "en": "Yay!", "vi": "Thích quá!" },
        { "speaker": "mom", "en": "Shoes on, please.", "vi": "Mang giày vào nha con." },
        { "speaker": "child", "en": "Shoes on!", "vi": "Mang rồi!" },
        { "speaker": "mom", "en": "Hold my hand, please.", "vi": "Nắm tay mẹ nha con." },
        { "speaker": "child", "en": "Okay, Mommy.", "vi": "Dạ, mẹ." },
        { "speaker": "mom", "en": "Let's go!", "vi": "Mình đi thôi!" }
      ]
    },
    {
      "id": "going-out-d02",
      "titleEn": "Time to go home",
      "titleVi": "Về nhà thôi",
      "lines": [
        { "speaker": "dad", "en": "Time to go home.", "vi": "Về nhà thôi con." },
        { "speaker": "child", "en": "One more swing!", "vi": "Đu thêm lần nữa!" },
        { "speaker": "dad", "en": "Okay, one more. Then home.", "vi": "Ừ, thêm một lần nữa thôi. Rồi về nha." },
        { "speaker": "child", "en": "Okay, Daddy.", "vi": "Dạ, ba." },
        { "speaker": "dad", "en": "Wave bye-bye to the park!", "vi": "Vẫy tay chào công viên nào!" },
        { "speaker": "child", "en": "Bye-bye, park!", "vi": "Bái bai công viên!" },
        { "speaker": "dad", "en": "Time to buckle up.", "vi": "Thắt dây an toàn nào." }
      ]
    },
    {
      "id": "going-out-d03",
      "titleEn": "Riding the bus",
      "titleVi": "Đi xe buýt",
      "lines": [
        { "speaker": "dad", "en": "Let's ride the bus!", "vi": "Mình đi xe buýt nha!" },
        { "speaker": "child", "en": "Bus!", "vi": "Xe buýt!" },
        { "speaker": "dad", "en": "Hold my hand, please.", "vi": "Nắm tay ba nha con." },
        { "speaker": "child", "en": "Okay, Daddy.", "vi": "Dạ, ba." },
        { "speaker": "dad", "en": "I see a bird! Can you see it?", "vi": "Có con chim kìa! Con thấy không?" },
        { "speaker": "child", "en": "Yes! Bird!", "vi": "Dạ thấy! Con chim!" },
        { "speaker": "dad", "en": "Wave bye-bye to the bird!", "vi": "Vẫy tay chào con chim nào!" },
        { "speaker": "child", "en": "Bye-bye, bird!", "vi": "Bái bai chim!" }
      ]
    }
  ]
}
