  "dialogues": [
    {
      "id": "car-ride-d01",
      "titleEn": "Buckle up",
      "titleVi": "Cài dây an toàn",
      "lines": [
        {
          "speaker": "dad",
          "en": "Into the car we go!",
          "vi": "Mình lên xe nào!"
        },
        {
          "speaker": "child",
          "en": "Buckle me!",
          "vi": "Cài dây cho con!"
        },
        {
          "speaker": "dad",
          "en": "Click! All buckled in.",
          "vi": "Tách! Cài dây xong rồi."
        },
        {
          "speaker": "child",
          "en": "Beep beep!",
          "vi": "Bíp bíp!"
        },
        {
          "speaker": "dad",
          "en": "Beep beep! Here we go!",
          "vi": "Bíp bíp! Mình đi nào!"
        }
      ],
      "ages": [
        "3-5"
      ]
    },
    {
      "id": "car-ride-d02",
      "titleEn": "Red light, green light",
      "titleVi": "Đèn đỏ, đèn xanh",
      "lines": [
        {
          "speaker": "mom",
          "en": "The light is red.",
          "vi": "Đèn đỏ rồi kìa."
        },
        {
          "speaker": "child",
          "en": "Red light!",
          "vi": "Đèn đỏ!"
        },
        {
          "speaker": "mom",
          "en": "Red means stop.",
          "vi": "Đèn đỏ là dừng lại."
        },
        {
          "speaker": "child",
          "en": "Green now!",
          "vi": "Xanh rồi!"
        },
        {
          "speaker": "mom",
          "en": "Green means go!",
          "vi": "Đèn xanh là đi!"
        },
        {
          "speaker": "child",
          "en": "Go, car, go!",
          "vi": "Chạy đi, xe hơi ơi!"
        }
      ],
      "ages": [
        "3-5"
      ]
    },
    {
      "id": "car-ride-d03",
      "titleEn": "Are we there yet?",
      "titleVi": "Tới chưa?",
      "lines": [
        {
          "speaker": "child",
          "en": "Are we there yet?",
          "vi": "Tới chưa mẹ?"
        },
        {
          "speaker": "mom",
          "en": "Not yet. We're driving to Grandma's house.",
          "vi": "Chưa con. Mình đang đi nhà bà nè."
        },
        {
          "speaker": "child",
          "en": "Music, please!",
          "vi": "Mở nhạc cho con nghe!"
        },
        {
          "speaker": "mom",
          "en": "Do you want to listen to music?",
          "vi": "Con muốn nghe nhạc không?"
        },
        {
          "speaker": "child",
          "en": "Yes! Music!",
          "vi": "Dạ! Nghe nhạc!"
        },
        {
          "speaker": "mom",
          "en": "We're almost there!",
          "vi": "Sắp tới rồi con!"
        }
      ],
      "ages": [
        "3-5",
        "5-7"
      ]
    },
    {
      "id": "car-ride-d04",
      "titleEn": "How much longer?",
      "titleVi": "Còn bao lâu nữa?",
      "lines": [
        {
          "speaker": "child",
          "en": "I'm bored. How much longer?",
          "vi": "Con chán quá. Còn bao lâu nữa ba?"
        },
        {
          "speaker": "dad",
          "en": "About twenty minutes. Want to play a game?",
          "vi": "Khoảng hai mươi phút nữa. Con muốn chơi trò gì không?"
        },
        {
          "speaker": "child",
          "en": "Can we play I spy?",
          "vi": "Mình chơi trò đoán đồ vật nha?"
        },
        {
          "speaker": "dad",
          "en": "Sure! I spy something yellow.",
          "vi": "Được! Ba thấy một thứ màu vàng."
        },
        {
          "speaker": "child",
          "en": "Is it the bus?",
          "vi": "Là chiếc xe buýt hả?"
        },
        {
          "speaker": "dad",
          "en": "Nope! Try again.",
          "vi": "Không phải! Con đoán lại đi."
        },
        {
          "speaker": "child",
          "en": "The taxi over there!",
          "vi": "Chiếc taxi đằng kia!"
        },
        {
          "speaker": "dad",
          "en": "You got it! Your turn.",
          "vi": "Đúng rồi! Tới lượt con đó."
        }
      ],
      "ages": [
        "5-7"
      ]
    },
    {
      "id": "car-ride-d05",
      "titleEn": "Can I sit in the front?",
      "titleVi": "Con ngồi ghế trước được không?",
      "lines": [
        {
          "speaker": "child",
          "en": "Mom, can I sit in the front seat today?",
          "vi": "Mẹ ơi, hôm nay con ngồi ghế trước được không?"
        },
        {
