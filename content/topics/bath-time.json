      "titleEn": "Into the tub",
      "titleVi": "Vô bồn tắm",
      "lines": [
        {
          "speaker": "mom",
          "en": "Time for a bath!",
          "vi": "Tới giờ tắm rồi!"
        },
        {
          "speaker": "child",
          "en": "Bubbles!",
          "vi": "Bong bóng!"
