{
  "topicId": "safety",
  "phrases": [
    { "id": "safety-001", "speaker": "parent", "level": 1, "en": "Stop and wait.", "vi": "Dừng lại, đợi chút nào." },
    { "id": "safety-002", "speaker": "parent", "level": 2, "en": "It's hot. Let's wait.", "vi": "Nóng đó con. Mình đợi chút nha." },
    { "id": "safety-003", "speaker": "parent", "level": 2, "en": "Hold my hand to cross.", "vi": "Nắm tay để qua đường nha con." },
    { "id": "safety-004", "speaker": "parent", "level": 1, "en": "Walking feet, please.", "vi": "Đi từ từ thôi nha con." },
    {
      "id": "safety-005", "speaker": "parent", "level": 2,
      "en": "Let's stay away from the ___.", "vi": "Mình tránh xa ___ ra nha.",
      "slots": [
        { "en": "stove", "vi": "bếp" },
        { "en": "road", "vi": "lòng đường" },
