        },
        {
          "en": "orange",
          "vi": "cam"
        },
        {
          "en": "cherry",
          "vi": "anh đào"
        }
      ]
    },
    {
      "id": "feeling-sick-026",
      "speaker": "parent",
      "level": 2,
      "en": "Let's stay home and ___.",
      "vi": "Mình ở nhà ___ nha.",
      "slots": [
        {
          "en": "rest",
          "vi": "nghỉ ngơi"
        },
        {
          "en": "sleep",
          "vi": "ngủ"
        },
        {
          "en": "read books",
          "vi": "đọc sách"
        },
        {
          "en": "cuddle",
          "vi": "ôm nhau"
        }
      ]
    },
    {
      "id": "feeling-sick-027",
      "speaker": "parent",
      "level": 2,
      "en": "You're being so brave.",
      "vi": "Con dũng cảm lắm nè."
    },
    {
      "id": "feeling-sick-028",
      "speaker": "child",
      "level": 2,
      "en": "My nose is runny.",
      "vi": "Con bị sổ mũi."
    },
    {
      "id": "feeling-sick-029",
      "speaker": "child",
      "level": 2,
      "en": "I want to lie down.",
      "vi": "Con muốn nằm."
    },
    {
      "id": "feeling-sick-030",
      "speaker": "child",
      "level": 1,
      "en": "More hugs, please.",
      "vi": "Ôm con nữa đi."
    }
  ],
  "dialogues": [
    {
      "id": "feeling-sick-d01",
      "titleEn": "Tummy ache",
      "titleVi": "Đau bụng",
      "lines": [
        {
          "speaker": "child",
          "en": "My tummy hurts.",
          "vi": "Con đau bụng."
        },
        {
          "speaker": "mom",
          "en": "Oh, poor sweetie. Show me where it hurts.",
          "vi": "Ôi, thương con quá. Chỉ mẹ coi đau chỗ nào nè."
        },
        {
          "speaker": "child",
          "en": "Right here.",
          "vi": "Chỗ này nè."
        },
        {
          "speaker": "mom",
          "en": "Cuddle up with your teddy. You need lots of rest.",
          "vi": "Ôm gấu bông của con nè. Con cần nghỉ ngơi thật nhiều nha."
        },
        {
          "speaker": "child",
          "en": "Hold me, please.",
          "vi": "Ôm con đi mẹ."
        },
        {
          "speaker": "mom",
          "en": "Come here. You'll feel better soon.",
          "vi": "Lại đây con. Con sẽ khỏe lại sớm thôi."
        }
      ]
    },
    {
      "id": "feeling-sick-d02",
      "titleEn": "Medicine time",
      "titleVi": "Giờ uống thuốc",
      "lines": [
        {
          "speaker": "dad",
          "en": "You feel a little warm.",
          "vi": "Người con hơi ấm ấm nè."
        },
        {
          "speaker": "child",
          "en": "I don't feel good.",
          "vi": "Con thấy không khỏe."
        },
        {
          "speaker": "dad",
          "en": "Time for your medicine. Open up!",
          "vi": "Tới giờ uống thuốc rồi con. Há miệng nào!"
        },
        {
          "speaker": "child",
          "en": "Gulp!",
          "vi": "Ực!"
        },
        {
          "speaker": "dad",
          "en": "Good job! Have a little water.",
          "vi": "Giỏi quá! Con uống nước một chút nha."
        },
        {
          "speaker": "child",
          "en": "All gone!",
          "vi": "Hết rồi!"
        }
      ]
    },
    {
      "id": "feeling-sick-d03",
      "titleEn": "Feeling better",
      "titleVi": "Khỏe hơn rồi",
      "lines": [
        {
          "speaker": "child",
          "en": "Achoo!",
          "vi": "Hắt xì!"
        },
        {
          "speaker": "dad",
          "en": "Bless you! Do you need a tissue?",
          "vi": "Ôi, hắt xì rồi! Con có cần khăn giấy không?"
        },
        {
          "speaker": "child",
          "en": "Tissue, please.",
          "vi": "Cho con khăn giấy."
        },
        {
          "speaker": "dad",
          "en": "Here you go. How do you feel?",
          "vi": "Nè con. Con thấy sao rồi?"
        },
        {
          "speaker": "child",
          "en": "I'm feeling better!",
          "vi": "Con đỡ rồi!"
        },
        {
          "speaker": "dad",
          "en": "Yay! I'm so happy!",
          "vi": "Hoan hô! Ba vui quá!"
        }
      ]
    }
  ]
}
