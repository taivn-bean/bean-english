  "dialogues": [
    {
      "id": "animals-d01",
      "titleEn": "Animal sounds",
      "titleVi": "Tiếng kêu con vật",
      "lines": [
        {
          "speaker": "dad",
          "en": "What does the cow say?",
          "vi": "Con bò kêu sao?"
        },
        {
          "speaker": "child",
          "en": "Moo, moo!",
          "vi": "Ụm bò, ụm bò!"
        },
        {
          "speaker": "dad",
          "en": "Yes! The cow says moo! What does the dog say?",
          "vi": "Đúng rồi! Con bò kêu ụm bò! Con chó kêu sao?"
        },
        {
          "speaker": "child",
          "en": "Woof, woof!",
          "vi": "Gâu gâu!"
        },
        {
          "speaker": "dad",
          "en": "What does the duck say?",
          "vi": "Con vịt kêu sao?"
        },
        {
          "speaker": "child",
          "en": "Quack, quack!",
          "vi": "Cạp cạp!"
        }
      ]
    },
    {
      "id": "animals-d02",
      "titleEn": "At the zoo",
      "titleVi": "Đi sở thú",
      "lines": [
        {
          "speaker": "mom",
          "en": "Do you see the elephant?",
          "vi": "Con có thấy con voi không?"
        },
        {
          "speaker": "child",
