  "dialogues": [
    {
      "id": "days-time-d01",
      "titleEn": "Is it a school day?",
      "titleVi": "Hôm nay có đi học không?",
      "ages": [
        "5-7"
      ],
      "lines": [
        {
          "speaker": "child",
          "en": "Daddy, is it a school day today?",
          "vi": "Ba ơi, hôm nay có đi học không?"
        },
        {
          "speaker": "dad",
          "en": "Hmm, what day is it today?",
          "vi": "Hừm, hôm nay thứ mấy ta?"
        },
        {
          "speaker": "child",
          "en": "Um... Saturday?",
          "vi": "Ừm... thứ Bảy hả?"
        },
        {
          "speaker": "dad",
          "en": "Nope. Yesterday was Saturday.",
          "vi": "Không phải. Hôm qua mới là thứ Bảy."
        },
        {
          "speaker": "child",
          "en": "So today is Sunday!",
          "vi": "Vậy hôm nay là Chủ nhật!"
        },
        {
          "speaker": "dad",
          "en": "That's right! No school today.",
          "vi": "Đúng rồi! Hôm nay không đi học."
        },
        {
          "speaker": "child",
          "en": "Yay! Can we go to the park?",
          "vi": "Yeah! Mình đi công viên được không ba?"
        },
        {
          "speaker": "dad",
          "en": "Sure. Let's go after breakfast.",
          "vi": "Được chứ. Ăn sáng xong mình đi."
        }
      ]
    },
    {
      "id": "days-time-d02",
      "titleEn": "Five more minutes",
      "titleVi": "Thêm năm phút nữa",
      "ages": [
        "5-7"
      ],
      "lines": [
        {
          "speaker": "mom",
          "en": "We're leaving in five minutes, okay?",
          "vi": "Năm phút nữa mình về nha con?"
        },
        {
          "speaker": "child",
          "en": "Aw, ten more minutes, please!",
          "vi": "Ứ, cho con mười phút nữa đi!"
        },
        {
          "speaker": "mom",
          "en": "Five minutes. Then it's time for dinner.",
          "vi": "Năm phút thôi. Rồi về ăn tối."
        },
        {
          "speaker": "child",
          "en": "How long is five minutes?",
          "vi": "Năm phút là bao lâu vậy mẹ?"
        },
        {
          "speaker": "mom",
          "en": "About three more turns on the slide.",
          "vi": "Khoảng ba lần chơi cầu tuột nữa đó."
        },
        {
          "speaker": "child",
          "en": "Okay! One... two... three!",
          "vi": "Dạ! Một... hai... ba!"
        },
        {
          "speaker": "mom",
          "en": "Time's up! Let's go home.",
          "vi": "Hết giờ rồi! Mình về nhà thôi."
        },
        {
          "speaker": "child",
          "en": "Okay. Bye, slide!",
          "vi": "Dạ. Tạm biệt cầu tuột!"
        }
      ]
    },
    {
      "id": "days-time-d03",
      "titleEn": "Counting down to my birthday",
      "titleVi": "Đếm ngày tới sinh nhật",
      "ages": [
        "5-7"
      ],
      "lines": [
        {
          "speaker": "child",
          "en": "Is it my birthday yet?",
          "vi": "Tới sinh nhật con chưa?"
        },
        {
          "speaker": "mom",
          "en": "Not yet. Your birthday is on Friday.",
          "vi": "Chưa đâu con. Thứ Sáu mới tới sinh nhật con."
        },
        {
          "speaker": "child",
          "en": "What day is it today?",
          "vi": "Hôm nay là thứ mấy?"
        },
        {
          "speaker": "dad",
          "en": "Today is Tuesday. So how many more days?",
          "vi": "Hôm nay thứ Ba. Vậy còn mấy ngày nữa?"
        },
        {
          "speaker": "child",
          "en": "Wednesday, Thursday, Friday... Three days!",
          "vi": "Thứ Tư, thứ Năm, thứ Sáu... Ba ngày!"
        },
        {
          "speaker": "dad",
          "en": "Good counting! Just three more days.",
          "vi": "Đếm giỏi quá! Ngủ thêm ba đêm nữa thôi."
        },
        {
          "speaker": "child",
          "en": "And I'm going to be six!",
          "vi": "Rồi con được sáu tuổi!"
        },
        {
          "speaker": "mom",
          "en": "Six! You're growing up so fast.",
          "vi": "Sáu tuổi! Con lớn nhanh quá."
        }
      ]
    },
    {
      "id": "days-time-d04",
      "titleEn": "Reading the clock",
      "titleVi": "Xem đồng hồ",
      "ages": [
        "5-7"
      ],
      "lines": [
        {
          "speaker": "dad",
          "en": "Can you tell me what time it is?",
          "vi": "Con coi giùm ba mấy giờ rồi?"
        },
        {
          "speaker": "child",
          "en": "The short hand is on the eight.",
          "vi": "Kim ngắn chỉ số tám."
        },
        {
          "speaker": "dad",
          "en": "And the long hand?",
          "vi": "Còn kim dài?"
        },
        {
          "speaker": "child",
          "en": "It's on the twelve.",
          "vi": "Nó chỉ số mười hai."
        },
        {
          "speaker": "dad",
          "en": "So it's...",
          "vi": "Vậy là..."
        },
        {
          "speaker": "child",
          "en": "Eight o'clock!",
          "vi": "Tám giờ!"
        },
        {
          "speaker": "dad",
          "en": "You got it! And what happens at eight o'clock?",
          "vi": "Đúng rồi! Mà tám giờ là giờ gì nhỉ?"
        },
        {
          "speaker": "child",
          "en": "Uh-oh. Bedtime?",
          "vi": "Ui. Giờ đi ngủ hả?"
        },
        {
          "speaker": "dad",
          "en": "Yep! Go brush your teeth.",
          "vi": "Đúng rồi! Đi đánh răng nha con."
        }
      ]
    },
    {
      "id": "days-time-d05",
      "titleEn": "Favorite season",
      "titleVi": "Mùa con thích nhất",
      "ages": [
        "5-7"
      ],
      "lines": [
        {
          "speaker": "mom",
          "en": "What's your favorite season?",
          "vi": "Con thích mùa nào nhất?"
        },
        {
          "speaker": "child",
          "en": "Summer! Because there's no school!",
          "vi": "Mùa hè! Vì được nghỉ học!"
        },
        {
          "speaker": "mom",
          "en": "Ha! What else do you like about summer?",
          "vi": "Ha! Còn thích gì nữa ở mùa hè?"
        },
        {
          "speaker": "child",
          "en": "Swimming and ice cream.",
          "vi": "Đi bơi với ăn kem."
        },
        {
          "speaker": "mom",
          "en": "Me too. What season comes after summer?",
          "vi": "Mẹ cũng vậy. Hết mùa hè là tới mùa gì?"
        },
        {
          "speaker": "child",
          "en": "Um... fall?",
          "vi": "Ừm... mùa thu?"
        },
        {
          "speaker": "mom",
          "en": "Yes! Then winter, then spring.",
          "vi": "Đúng rồi! Rồi tới mùa đông, rồi mùa xuân."
        },
        {
          "speaker": "child",
          "en": "And then summer again!",
          "vi": "Rồi lại tới mùa hè!"
        }
      ]
    }
  ]
}
